# JavaScript bridge injected into pano.html. R8 must never rename or strip
# the class (looked up by string "PanoBridge") or its @JavascriptInterface
# methods, or the panorama viewer breaks in release builds.
-keep class com.fafoguesser.app.ui.panorama.PanoBridge { *; }
-keepclassmembers class com.fafoguesser.app.ui.panorama.PanoBridge { public *; }

# Belt and braces: never touch @JavascriptInterface members anywhere.
-keepclassmembers class * {
    @android.webkit.JavascriptInterface <methods>;
}