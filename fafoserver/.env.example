# FafoGuesser server — copy to .env and fill in
PORT=8787
DB_PATH=data/leaderboard.db
# Free client access token from https://www.mapillary.com/dashboard/developers
MAPILLARY_TOKEN=
# Used for the guess map tiles (web) — optional for dev
MAPTILER_KEY=
# Comma-separated list of allowed browser origins (web app)
CORS_ORIGINS=http://localhost:5173,http://localhost:4173
# Node environment
NODE_ENV=development
