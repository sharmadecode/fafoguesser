# FafoGuesser server — copy to .env and fill in
PORT=8787
# Free client access token from https://www.mapillary.com/dashboard/developers
MAPILLARY_TOKEN=
# Comma-separated exact IPv4s and/or CIDRs of reverse proxies whose
# X-Forwarded-For headers may be trusted (e.g. Render LB: 10.0.0.0/8).
# Leave empty in local development.
PROXY_TRUST=
# Comma-separated list of allowed browser origins (web app)
CORS_ORIGINS=http://localhost:5173,http://localhost:4173
# Node environment (development | production)
NODE_ENV=development
